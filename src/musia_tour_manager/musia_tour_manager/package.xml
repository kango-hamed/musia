<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>musia_tour_manager</name>
  <version>0.1.0</version>
  <description>
    MUSIA Tour Manager — Orchestrateur central, machine à états 7 états.
    Cœur du système robot guide de musée Famienkro (ESATIC 2026).
  </description>
  <maintainer email="hamed@esatic.ci">Hamed</maintainer>
  <license>MIT</license>
 
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>musia_msgs</depend>
 
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>
 
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
