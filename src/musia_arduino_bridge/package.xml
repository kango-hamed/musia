<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>musia_arduino_bridge</name>
  <version>0.1.0</version>
  <description>
    MUSIA Arduino Bridge — Pont série RPi 5 ↔ Arduino Uno/Nano.
    Publie /ultrasonic_distance (Float32, cm) et /person_detected (Bool)
    à partir des données HC-SR04 transmises en JSON via USB.
  </description>

  <maintainer email="hamed@esatic.ci">Hamed</maintainer>
  <license>MIT</license>

  <!-- Build -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime ROS 2 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- Tests -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
