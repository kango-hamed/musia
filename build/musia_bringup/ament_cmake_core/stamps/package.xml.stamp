<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>musia_bringup</name>
  <version>0.1.0</version>
  <description>
    MUSIA Bringup — Launch files, configuration et carte pour le robot
    guide de musée Famienkro (ESATIC 2026).
    Orchestre le démarrage de musia_tour_manager, musia_arduino_bridge et Nav2.
  </description>
  <maintainer email="hamed@esatic.ci">Hamed</maintainer>
  <license>MIT</license>

  <!-- Dépendances launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Packages MUSIA -->
  <exec_depend>musia_tour_manager</exec_depend>
  <exec_depend>musia_arduino_bridge</exec_depend>
  <exec_depend>musia_msgs</exec_depend>

  <!-- Nav2 -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>

  <!-- TF -->
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
